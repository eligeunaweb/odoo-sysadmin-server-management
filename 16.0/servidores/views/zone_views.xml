<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sysadmin_dns_zone" model="ir.actions.act_window">
        <field name="name">Zonas DNS</field>
        <field name="res_model">sysadmin.dns.zone</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sysadmin_zone_tree" model="ir.ui.view">
        <field name="name">sysadmin.dns.zone.tree</field>
        <field name="model">sysadmin.dns.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="responsible_user_id"/>
                <field name="note" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_sysadmin_zone_form" model="ir.ui.view">
        <field name="name">sysadmin.dns.zone.form</field>
        <field name="model">sysadmin.dns.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="responsible_user_id"/>
                            <field name="note"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Registros">
                            <field name="record_ids" context="{'default_zone_id': active_id, 'default_partner_id': partner_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="record_type"/>
                                    <field name="value"/>
                                    <field name="ttl"/>
                                    <field name="priority" optional="hide"/>
                                    <field name="server_id" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
