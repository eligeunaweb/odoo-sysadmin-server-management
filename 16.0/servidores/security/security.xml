<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_sysadmin" model="ir.module.category">
        <field name="name">Sys Admin</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sysadmin_user" model="res.groups">
        <field name="name">Sys Admin / Usuario</field>
        <field name="category_id" ref="module_category_sysadmin"/>
    </record>

    <record id="group_sysadmin_manager" model="res.groups">
        <field name="name">Sys Admin / Administrador</field>
        <field name="category_id" ref="module_category_sysadmin"/>
    </record>

    <!-- Reglas: los usuarios ven solo lo que tengan como responsable -->
    <record id="rule_server_own" model="ir.rule">
        <field name="name">Servidores: solo propios</field>
        <field name="model_id" ref="model_sysadmin_server"/>
        <field name="domain_force">[('responsible_user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sysadmin_user'))]"/>
    </record>

    <record id="rule_interface_own" model="ir.rule">
        <field name="name">Interfaces: solo de servidores propios</field>
        <field name="model_id" ref="model_sysadmin_server_interface"/>
        <field name="domain_force">[('server_id.responsible_user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sysadmin_user'))]"/>
    </record>

    <record id="rule_zone_own" model="ir.rule">
        <field name="name">Zonas DNS: solo propias</field>
        <field name="model_id" ref="model_sysadmin_dns_zone"/>
        <field name="domain_force">[('responsible_user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sysadmin_user'))]"/>
    </record>

    <record id="rule_dns_own" model="ir.rule">
        <field name="name">DNS: solo propios</field>
        <field name="model_id" ref="model_sysadmin_dns_record"/>
        <field name="domain_force">[('responsible_user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sysadmin_user'))]"/>
    </record>
</odoo>
