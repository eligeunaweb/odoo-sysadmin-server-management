<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sysadmin_server" model="ir.actions.act_window">
        <field name="name">Servidores</field>
        <field name="res_model">sysadmin.server</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sysadmin_server_tree" model="ir.ui.view">
        <field name="name">sysadmin.server.tree</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'inactive'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="location"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'inactive'"/>
                <field name="responsible_user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_sysadmin_server_form" model="ir.ui.view">
        <field name="name">sysadmin.server.form</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activar" class="btn-primary" attrs="{'invisible':[('state','=','active')]}"/>
                    <button name="action_deactivate" type="object" string="Desactivar" class="btn-secondary" attrs="{'invisible':[('state','=','inactive')]}"/>
                    <field name="state" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet>
                        <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: srv-web-01"/></h1>
                    </div>

                    <group>
                        <group string="Cliente">
                            <field name="partner_id"/>
                            <field name="responsible_user_id"/>
                            <field name="location"/>
                        </group>
                        <group string="Keycloak">
                            <field name="keycloak_client"/>
                            <field name="keycloak_secret" password="True"/>
                        </group>
                    </group>

                    <group string="Hardware">
                        <field name="motherboard"/>
                        <field name="cpu"/>
                        <field name="ram_gb"/>
                        <field name="storage_type"/>
                        <field name="storage_size_gb"/>
                    </group>

                    <notebook>
                        <page string="Interfaces">
                            <field name="interface_ids" context="{'default_server_id': active_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="dns_name"/>
                                    <field name="mac"/>
                                    <field name="ipv4"/>
                                    <field name="ipv6"/>
                                    <field name="connected_to"/>
                                    <field name="port"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="DNS (del servidor)">
                            <field name="dns_record_ids" context="{'default_server_id': active_id, 'default_partner_id': partner_id, 'default_zone_id': False}">
                                <tree editable="bottom">
                                    <field name="zone_id"/>
                                    <field name="name"/>
                                    <field name="record_type"/>
                                    <field name="value"/>
                                    <field name="ttl"/>
                                    <field name="priority" optional="show"/>
                                    <field name="weight" optional="hide"/>
                                    <field name="port" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="description" placeholder="Información general, credenciales, observaciones…"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sysadmin_server_kanban" model="ir.ui.view">
        <field name="name">sysadmin.server.kanban</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('sysadmin.server', 'image_128', record.id.raw_value)" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="partner_id"/></div>
                                <div>[<field name="state"/>]</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
