<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sysadmin_dns_record" model="ir.actions.act_window">
        <field name="name">DNS</field>
        <field name="res_model">sysadmin.dns.record</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sysadmin_dns_search" model="ir.ui.view">
        <field name="name">sysadmin.dns.record.search</field>
        <field name="model">sysadmin.dns.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="zone_id"/>
                <field name="server_id"/>
                <field name="record_type"/>
                <field name="name"/>
                <field name="value"/>
                <filter string="Sin servidor" name="no_server" domain="[('server_id','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Zona" name="group_zone" context="{'group_by':'zone_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by':'record_type'}"/>
                    <filter string="Servidor" name="group_server" context="{'group_by':'server_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sysadmin_dns_tree" model="ir.ui.view">
        <field name="name">sysadmin.dns.record.tree</field>
        <field name="model">sysadmin.dns.record</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="zone_id"/>
                <field name="name"/>
                <field name="record_type"/>
                <field name="value"/>
                <field name="ttl"/>
                <field name="priority" optional="hide"/>
                <field name="server_id" optional="hide"/>
                <field name="responsible_user_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_sysadmin_dns_form" model="ir.ui.view">
        <field name="name">sysadmin.dns.record.form</field>
        <field name="model">sysadmin.dns.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="zone_id" options="{'no_create_edit': False}"/>
                        </group>
                        <group>
                            <field name="server_id"/>
                            <field name="responsible_user_id"/>
                        </group>
                    </group>

                    <group string="Registro">
                        <field name="name"/>
                        <field name="record_type"/>
                        <field name="value"/>
                        <field name="ttl"/>
                    </group>

                    <group string="Opcional">
                        <field name="priority" attrs="{'invisible':[('record_type','not in',('MX','SRV'))]}"/>
                        <field name="weight" attrs="{'invisible':[('record_type','!=','SRV')]}"/>
                        <field name="port" attrs="{'invisible':[('record_type','!=','SRV')]}"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
