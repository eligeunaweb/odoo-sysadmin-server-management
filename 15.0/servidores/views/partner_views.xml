<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_sysadmin" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sysadmin</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_sysadmin_servers" class="oe_stat_button" icon="fa-server"
                        attrs="{'invisible':[('is_company','=',False)]}">
                    <field string="Servidores" name="sysadmin_server_count" widget="statinfo"/>
                </button>
                <button type="object" name="action_view_sysadmin_zones" class="oe_stat_button" icon="fa-globe"
                        attrs="{'invisible':[('is_company','=',False)]}">
                    <field string="Zonas DNS" name="sysadmin_zone_count" widget="statinfo"/>
                </button>
                <button type="object" name="action_view_sysadmin_dns" class="oe_stat_button" icon="fa-sitemap"
                        attrs="{'invisible':[('is_company','=',False)]}">
                    <field string="DNS" name="sysadmin_dns_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
